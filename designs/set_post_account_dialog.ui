   <string notr="true">QWidget, #post_group {
	background-color: rgb(226, 241, 255);
    border-radius: 6px;
}

/* GroupBox panels */
QGroupBox {
	
	background-color: rgb(255, 188, 218);
    border: 2px solid rgb(157, 178, 255); /* very subtle border */
    border-radius: 8px;
    margin-top: 10px;
    padding:4px;
    font-weight: bold;
}

/* Optional: GroupBox title */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 4px;
	color: rgb(16, 16, 16);
font-size: 18px;
}
QPushButton {
	background-color: rgb(74, 81, 127);
    color: white;     /* dark gray text */
    border: none;
    border-radius: 6px;
    padding: 3px 13px;
    font-weight: bold;

}

QPushButton:hover {
    background-color: #F48EB9;
}

QPushButton:pressed {
    background-color: #E96DA4;  /* deeper pink when pressed */
}

QPushButton:disabled {
    background-color: #FBD8E4;  /* faded pink for disabled state */
    color: #999999;
}
/* ComboBox Main Style */
QComboBox {
    background-color: #FFFFFF; /* white so it stands out on aqua panel */
    color: rgb(50, 50, 50);    /* dark gray text */
    border: 1px solid #A3C9D4; /* subtle aqua border */
    border-radius: 6px;
    padding: 4px 8px;
}

/* ComboBox Main Style */
QComboBox {
	background-color: rgb(85, 170, 255);
	color: rgb(255, 255, 255);
    border: 1px solid #A3C9D4; /* subtle aqua border */
    border-radius: 6px;
    padding: 4px 8px;
}

/* Drop-down Button */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
	background-color: rgb(77, 155, 232);
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Arrow Icon */
QComboBox::down-arrow {
	image: url(:/icons/images/down-arrow.png);
    width: 16px;
    height: 16px;
}

/* Popup List */
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #A3C9D4;
    selection-background-color: #F6AAC9; /* pastel pink highlight */
    selection-color: rgb(50, 50, 50);
}
/* LineEdit Style */
QLineEdit {
    background-color: #FFFFFF; /* clean white for good contrast */
    color: rgb(50, 50, 50);    /* dark gray text */
    border: 1px solid #A3C9D4; /* same subtle aqua border as ComboBox */
    border-radius: 6px;
    padding: 4px 8px;
    selection-background-color: #F6AAC9; /* pastel pink text highlight */
    selection-color: rgb(50, 50, 50);
}

/* Focused (active) state */
QLineEdit:focus {
    border: 2px solid #F6AAC9; /* pink border when focused */
    outline: none;
}

/* ---------------------------------------------------------------------------
 * QTableWidget -- A detailed, professional style
 * --------------------------------------------------------------------------- */

/* Style for the checkbox indicator inside the table */
QTableWidget::indicator {
    width: 16px;
    height: 16px;
    background-color: white;
    border: 2px solid rgb(136, 199, 247);
    border-radius: 5px;
}

/* Style for when the mouse is hovering over the indicator */
QTableWidget::indicator:hover {
    border: 2px solid rgb(42, 126, 0); 
}

/* Style for when the checkbox is checked */
QTableWidget::indicator:checked {
    image: url(:/icons/images/checkmark.png);
    background-color: white; /* Keeps background white when checked */
    border: 2px solid rgb(136, 199, 247);
}

/* Style for when a checked checkbox is hovered */
QTableWidget::indicator:checked:hover {
    border: 2px solid rgb(42, 126, 0);
}

/* Style for when the checkbox is disabled */
QTableWidget::indicator:disabled {
    background-color: #3B4252;
    border: 1px solid #434C5E;
}

/* ---------------------------------------------------------------------------
 * QHeaderView -- Styling for the top header
 * --------------------------------------------------------------------------- */

/* The entire header bar */
QHeaderView {
	background-color: rgb(248, 251, 255);
}

/* Each individual section/column in the header */
QHeaderView::section {
	background-color: rgb(213, 242, 250);
    border: none;
    text-align: center; /* Ensure text is aligned left */
padding: 1px;
}

/* Style for when a header section is clicked/pressed */
QHeaderView::section:pressed {
	border: none;
}

/* The small sort indicator arrow that appears when you click a header */
QHeaderView::down-arrow {
    
	image: url(:/icons/images/down-arrow.png);
}

QHeaderView::up-arrow {
    image: url(:/icons/images/down-arrow.png);
}

/* ---------------------------------------------------------------------------
 * QScrollBar -- Styling for the vertical and horizontal scrollbars
 * --------------------------------------------------------------------------- */

/* Vertical Scrollbar */
QScrollBar:vertical {
    border: none;
    background: #2E3440; /* Match the darkest background */
    width: 14px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: #4C566A; /* Handle color */
    min-height: 10px;
    border-radius: 7px;
}
QScrollBar::handle:vertical:hover {
    background: #5E81AC; /* Highlight on hover */
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px; /* Hide the top and bottom arrow buttons */
    background: none;
}

/* Horizontal Scrollbar */
QScrollBar:horizontal {
    border: none;
    background: #2E3440;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: #4C566A;
    min-width: 25px;
    border-radius: 7px;
}
QScrollBar::handle:horizontal:hover {
    background: #5E81AC;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px; /* Hide the left and right arrow buttons */
    background: none;
}

/* ---------------------------------------------------------------------------
 * QSpinBox -- Professional Dark Theme Style
 * --------------------------------------------------------------------------- */

QSpinBox {
	background-color: rgb(136, 199, 247);
    color: white; /* Light grey text */
    /*border: 1px solid #2E3440;  Darker border for depth */
    border-radius: 5px;
    padding: 4px; /* Give text some space */
    /*font-size: 14px;*/
}

QSpinBox:focus {
    /*border: 1px solid #88C0D0;  Cyan focus border, same as QLineEdit */
}


/* --- Styling the Up and Down Buttons --- */

QSpinBox::up-button {
background-color:  rgb(125, 151, 216);
    subcontrol-position: top right; /* Position at the top right */
    width: 20px;
    border-top-right-radius: 5px;
}

QSpinBox::down-button {
background-color:  rgb(125, 151, 216);
    subcontrol-position: bottom right; /* Position at the bottom right */
    width: 20px;
    border-bottom-right-radius: 5px;
}

/* Style for when hovering over the buttons */
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #5E81AC; /* Main blue accent color */
}

/* --- Styling the Up and Down Arrows --- */

QSpinBox::up-arrow {
    image: url(:/icons/images/up-arrow.png); /* You need a white up-arrow icon */
    width: 17px;
    height: 17px;
}

QSpinBox::down-arrow {
    image: url(:/icons/images/down-arrow.png); /* You need a white down-arrow icon */
    width: 17px;
    height: 17px;
}


/* ---------------------------------------------------------------------------
 * QCheckBox -- Professional Dark Theme Style
 * --------------------------------------------------------------------------- */

/* Style for the entire checkbox widget (box + text) */
QCheckBox {
    color: black; /* Light grey text */
    spacing: 10px; /* Space between the box and the text */
}

/* Style for the checkable box itself */
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    background-color: white; /* Dark input field background */
    border: 2px solid rgb(136, 199, 247);  /* Darker border */
    border-radius: 5px;
}

/* Style for when the mouse is hovering over the checkbox */
QCheckBox::indicator:hover {
    border: 2px solid rgb(42, 126, 0); /* Lighter blue border on hover */
}

/* Style for when the checkbox is checked */
QCheckBox::indicator:checked {
    /* This displays a checkmark icon from your resources */
    image: url(:/icons/images/checkmark.png);
}

/* Style for when a checked checkbox is hovered */


/* Style for when the checkbox is disabled */
QCheckBox:disabled {
    color: #4C566A; /* Greyed-out text */
}

QCheckBox::indicator:disabled {
    background-color: #3B4252; /* Darker, disabled background */
    border: 1px solid #434C5E;
}



/* ---------------------------------------------------------------------------
 * QRadioButton — Pastel Aqua &amp; Pink Modern Style
 * --------------------------------------------------------------------------- */

QRadioButton {
    color: black;                /* Text color */
    spacing: 10px;               /* Space between circle and text */
    font-weight: medium;
}

/* Radio circle (indicator) */
QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 10px;          /* Make it round */
    border: 2px solid rgb(136, 199, 247);   /* Same blue tone as QCheckBox */
    background-color: white;     /* Base background */
}

/* Hover effect */
QRadioButton::indicator:hover {
    border: 2px solid rgb(42, 126, 0);      /* Light green-blue hover border */
}

/* Checked (active) state */
QRadioButton::indicator:checked {
    border: 2px solid rgb(129, 199, 132); /* Pastel green border */
    background-color: qradialgradient(
        cx: 0.5, cy: 0.5, radius: 0.6,
        fx: 0.5, fy: 0.5,
        stop: 0 rgb(102, 187, 106),
        stop: 1 white
    );
}


/* Disabled state */
QRadioButton:disabled {
    color: #4C566A;
}

QRadioButton::indicator:disabled {
    background-color: #E0E0E0;
    border: 1px solid #B0B0B0;
}

/* Focus state (optional glowing border) */
QRadioButton:focus {
    outline: none;
}

QRadioButton::indicator:focus {
    border: 2px solid rgb(157, 178, 255);
}


/* ---------------------------------------------------------------------------
 * QMenu -- Style for multi-level context menus
 * --------------------------------------------------------------------------- */

QMenu {
    background-color: #3B4252; /* Dark grey background */
    color: #ECEFF4; /* Light text */
    border: 1px solid #4C566A;
    border-radius: 5px;
    padding: 5px;
}
QMenu::icon {
  width: 24px;
    height: 24px;
    padding-left: 10px; /* 👈 Pushes icons to the right */
}

/* Style for each item in the menu */
QMenu::item {
    padding: 4px 6px;
    border-radius: 4px;
}

/* This is the hover effect for any menu item */
QMenu::item:selected {
    background-color: #5E81AC; /* Main blue accent color */
}
/* Style for the separator line */
QMenu::separator {
    height: 1px;
    background-color: #4C566A;
    margin: 5px 0px;
}

/* The arrow for submenus */
QMenu::right-arrow {
    image: url(:/icons/images/right-arrow-48.png); /* You need a right-arrow icon */
    width: 16px;
    height: 16px;
padding-right: 10px;
}

/* ------------------------------
   QTabWidget Base Pane
--------------------------------*/
QTabWidget::pane {
    border: 2px solid  rgb(157, 178, 255);        /* Light mint border */
    border-radius: 7px;
    background-color: #f1f8f6;        /* Very light green background */
    padding: 1px;
}

/* ------------------------------
   QTabBar (Tabs Container)
--------------------------------*/
QTabBar {
    qproperty-drawBase: 0; /* Prevents double border */
    background-color: transparent;
}

/* ------------------------------
   Tabs - General Style
--------------------------------*/
QTabBar::tab {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #e8f5e9,
        stop: 1 #c8e6c9
    );
    border: 1px solid  rgb(157, 178, 255);
    border-bottom: none;               /* So selected tab merges with pane */
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 100px;
    padding: 4px 7px;
    color: #2e7d32;                    /* Dark green text */
    margin-right: 3px;
}

/* ------------------------------
   Hovered Tab
--------------------------------*/
QTabBar::tab:hover {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #dcedc8,
        stop: 1 #aed581
    );
    border-color: #81c784;
}

/* ------------------------------
   Selected (Active) Tab
--------------------------------*/
QTabBar::tab:selected {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 0, y2: 1,
        stop: 0 #a5d6a7,
        stop: 1 #81c784
    );
    border-color: #66bb6a;
    color: white;
    font-weight: 600;
}

/* ------------------------------
   Disabled Tab
--------------------------------*/
QTabBar::tab:disabled {
    color: #bdbdbd;
    background-color: #f5f5f5;
    border-color: #dcdcdc;
}

/* ------------------------------
   Tab Positions (Optional)
--------------------------------*/
QTabBar::tab:top:selected {
    margin-bottom: -1px;
}

QTabBar::tab:bottom:selected {
    margin-top: -1px;
}

QTabBar::tab:left:selected {
    margin-right: -1px;
}

QTabBar::tab:right:selected {
    margin-left: -1px;
}</string>
