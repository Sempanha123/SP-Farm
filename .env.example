# =================================================================
# SP-FARM V2 — Environment Configuration Template
# Placeholders only. Copy to .env and fill in real values.
# NEVER commit .env to version control.
# =================================================================

# Environment Mode: development | testing | production
SPFARM_ENV=development

# Application Paths (leave empty to use system default AppData/spfarm)
SPFARM_DATA_DIR=
SPFARM_LOG_DIR=
SPFARM_BACKUP_DIR=
SPFARM_CACHE_DIR=

# Database Configuration
SPFARM_DB_URL=sqlite:///spfarm.db
SPFARM_DB_ECHO=false

# Logging Configuration: DEBUG | INFO | WARNING | ERROR | CRITICAL
SPFARM_LOG_LEVEL=INFO
SPFARM_LOG_JSON=false

# Security & Secret Store
# Master key placeholder for local secret encryption (leave empty to use Windows DPAPI / OS Keyring)
SPFARM_SECRET_KEY=

# Automation & Device Lab Settings
SPFARM_ADB_PATH=
SPFARM_LDPLAYER_PATH=
SPFARM_MUMU_PATH=
SPFARM_APPIUM_HOST=127.0.0.1
SPFARM_APPIUM_PORT=4723
